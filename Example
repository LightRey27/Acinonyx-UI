-- Acinonyx UI Library demo
-- This sample demonstrates UI controls only; callbacks do not change game state.

local Acinonyx = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/LightRey27/Acinonyx-UI/main/Init.lua"
))()

local Window = Acinonyx:CreateWindow({
	Name = "Acinonyx UI Demo",
})

local MainTab = Window:CreateTab("Main")
MainTab:CreateLabel("Player profile appears automatically in the sidebar footer.")

MainTab:CreateButton({
	Text = "Show notification",
	Callback = function()
		Window:Notify({
			Title = "Acinonyx UI",
			Text = "The notification component is working.",
			Duration = 3,
			Type = "success",
		})
	end,
})

MainTab:CreateToggle({
	Text = "Demo toggle",
	Default = false,
	Callback = function(enabled)
		print("Demo toggle:", enabled)
	end,
})

MainTab:CreateSlider({
	Text = "Demo value",
	Min = 0,
	Max = 100,
	Step = 5,
	Default = 50,
	Callback = function(value)
		print("Demo value:", value)
	end,
})

MainTab:CreateTextbox({
	Text = "Test input",
	Placeholder = "Enter text and press Enter",
	Callback = function(value)
		print("Test input received (length):", #value)
	end,
})

MainTab:CreateDropdown({
	Text = "Demo selection",
	Options = {"Option A", "Option B", "Option C"},
	Callback = function(option)
		print("Selected option:", option)
	end,
})

MainTab:CreateMultiDropdown({
	Text = "Demo multi-selection",
	Options = {"Alpha", "Beta", "Gamma"},
	Default = {"Alpha"},
	Callback = function(selected)
		print("Selected options:", table.concat(selected, ", "))
	end,
})

local HelpTab = Window:CreateTab("Help")
HelpTab:CreateLabel("Use Window:Destroy() to clean up the UI and its input connections.")
HelpTab:CreateButton({
	Text = "Close demo window",
	Callback = function()
		Window:Destroy()
	end,
})
